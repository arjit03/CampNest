<% for (suc of success) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <%= suc %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>
<% for (err of error) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  <%= err %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>